{
  "expo": {
    "name": "Franki",
    "slug": "franki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.fdsimms.franki",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withListeningActivity",
      "./plugins/withAppGroup",
      "./plugins/withShareExtension",
      "expo-sharing",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Prompt_300Light.ttf",
            "./assets/fonts/Prompt_400Regular.ttf",
            "./assets/fonts/Prompt_500Medium.ttf",
            "./assets/fonts/NotoSerifThai_300Light.ttf",
            "./assets/fonts/NotoSerifThai_400Regular.ttf",
            "./assets/fonts/NotoSerifThai_600SemiBold.ttf",
            "./assets/fonts/CormorantGaramond_300Light.ttf",
            "./assets/fonts/CormorantGaramond_400Regular.ttf",
            "./assets/fonts/CormorantGaramond_300Light_Italic.ttf",
            "./assets/fonts/Inter_400Regular.ttf",
            "./assets/fonts/Inter_600SemiBold.ttf",
            "./assets/fonts/Inter_700Bold.ttf",
            "./assets/fonts/Lora_400Regular.ttf",
            "./assets/fonts/Lora_600SemiBold.ttf",
            "./assets/fonts/Lora_700Bold.ttf",
            "./assets/fonts/Manrope_400Regular.ttf",
            "./assets/fonts/Manrope_600SemiBold.ttf",
            "./assets/fonts/Manrope_700Bold.ttf",
            "./assets/fonts/Nunito_400Regular.ttf",
            "./assets/fonts/Nunito_600SemiBold.ttf",
            "./assets/fonts/Nunito_700Bold.ttf",
            "./assets/fonts/SourceSerif4_400Regular.ttf",
            "./assets/fonts/SourceSerif4_600SemiBold.ttf",
            "./assets/fonts/SourceSerif4_700Bold.ttf",
            "./assets/fonts/Comfortaa_400Regular.ttf",
            "./assets/fonts/Comfortaa_600SemiBold.ttf",
            "./assets/fonts/Comfortaa_700Bold.ttf",
            "./assets/fonts/Alegreya_400Regular.ttf",
            "./assets/fonts/Alegreya_600SemiBold.ttf",
            "./assets/fonts/Alegreya_700Bold.ttf",
            "./assets/fonts/MarckScript_400Regular.ttf",
            "./assets/fonts/BadScript_400Regular.ttf",
            "./assets/fonts/Caveat_400Regular.ttf",
            "./assets/fonts/Caveat_600SemiBold.ttf",
            "./assets/fonts/Caveat_700Bold.ttf",
            "./assets/fonts/Mali_400Regular.ttf",
            "./assets/fonts/Mali_600SemiBold.ttf",
            "./assets/fonts/Mali_700Bold.ttf",
            "./assets/fonts/Sriracha_400Regular.ttf",
            "./assets/fonts/Mitr_400Regular.ttf",
            "./assets/fonts/Mitr_600SemiBold.ttf",
            "./assets/fonts/Mitr_700Bold.ttf",
            "./assets/fonts/Charmonman_400Regular.ttf",
            "./assets/fonts/Charmonman_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Franki uses the microphone when you record yourself, answer by speaking, or answer in an audio lesson. Recordings stay on this iPhone and are deleted when you move on.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Franki uses the camera when you photograph a page of a grammar book to start a grammar topic from it. The photo is sent to Claude only when you ask and isn't saved.",
          "photosPermission": "Franki reads a photo or screenshot of a grammar book's page that you choose, to start a grammar topic from it. It's sent to Claude only when you ask and isn't saved.",
          "microphonePermission": "Franki uses the microphone when you record yourself, answer by speaking, or answer in an audio lesson. Recordings stay on this iPhone and are deleted when you move on."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f4ef",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0f1115",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Franki uses the microphone when you record yourself, answer by speaking, or answer in an audio lesson. Recordings stay on this iPhone and are deleted when you move on.",
          "speechRecognitionPermission": "Franki turns what you say into text to compare with the answer, when you answer by speaking. Where iOS can, this happens on the iPhone; otherwise Apple's servers do it."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8282e0ab-8ac4-4b35-b6b4-fdf558c392c4",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "FrankiListening",
                  "bundleIdentifier": "com.fdsimms.franki.FrankiListening"
                },
                {
                  "targetName": "FrankiShare",
                  "bundleIdentifier": "com.fdsimms.franki.FrankiShare",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.fdsimms.franki"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "scheme": "franki"
  }
}

{
  "expo": {
    "name": "Franki",
    "slug": "franki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fdsimms.franki",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Prompt_300Light.ttf",
            "./assets/fonts/Prompt_400Regular.ttf",
            "./assets/fonts/Prompt_500Medium.ttf",
            "./assets/fonts/NotoSerifThai_300Light.ttf",
            "./assets/fonts/NotoSerifThai_400Regular.ttf",
            "./assets/fonts/NotoSerifThai_600SemiBold.ttf",
            "./assets/fonts/CormorantGaramond_300Light.ttf",
            "./assets/fonts/CormorantGaramond_400Regular.ttf",
            "./assets/fonts/CormorantGaramond_300Light_Italic.ttf"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Franki uses the microphone when you record yourself to compare with a recording, or answer by speaking. Recordings stay on this iPhone and are deleted when you move on, unless you ask to score one.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f4ef",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0f1115",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Franki uses the microphone when you record yourself to compare with a recording, or answer by speaking. Recordings stay on this iPhone and are deleted when you move on, unless you ask to score one.",
          "speechRecognitionPermission": "Franki turns what you say into text to compare with the answer, when you answer by speaking. Where iOS can, this happens on the iPhone; otherwise Apple's servers do it."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8282e0ab-8ac4-4b35-b6b4-fdf558c392c4"
      }
    },
    "scheme": "franki"
  }
}

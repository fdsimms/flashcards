    "expo-document-picker": "^58.0.5",
    "expo-file-system": "^58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-speech": "^58.0.4",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "^58.0.16",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.5",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:device": "expo run:ios --device",
    "build:ios": "sh scripts/build-ios.sh",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=Pacific/Kiritimati vitest run && TZ=Pacific/Pago_Pago vitest run && TZ=America/St_Johns vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run && TZ=Pacific/Kiritimati vitest run && git status --short",
    "catalog:skills": "UPDATE_SKILL_CATALOG=1 vitest run tests/tools/skillCatalog.test.ts",
    "api:types": "cd server/reader && uv run python -m franki_reader.openapi && cd ../.. && node scripts/api-types.mjs"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}

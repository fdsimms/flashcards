# Copy to .env and fill in. .env holds the password: it's in .gitignore, don't commit it.
DOMAIN=anki.example.com
ANKI_USER=me
ANKI_PASSWORD=choose-a-long-password

# The MCP, for using your collection from Claude (README.md, "Use it from Claude"), and Read &
# Listen (README.md, "Read & Listen"). Remove the # from COMPOSE_PROFILES and list the ones you
# want, separated by commas: mcp, reader, or mcp,reader.
# COMPOSE_PROFILES=mcp
# Asked for once when you connect a Claude app. At least 12 characters, not the Anki password.
MCP_PASSWORD=
# For recorded audio (the MCP's, optional, and Read & Listen's): an Azure Speech resource's key and
# region, e.g. westeurope.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: an Azure Speech address to use instead of the region's own (a custom domain).
# AZURE_SPEECH_ENDPOINT=https://my-speech.cognitiveservices.azure.com

# Read & Listen. The passphrase is typed once in the app; make it long, and not the Anki or MCP one.
READER_PASSPHRASE=
# Optional: Thai's man's and woman's voices, when not th-TH-NiwatNeural and th-TH-PremwadeeNeural.
# AZURE_VOICE_MALE=
# AZURE_VOICE_FEMALE=
# A Claude API key, for writing the texts.
ANTHROPIC_API_KEY=
# Backups of its database (optional, recommended): an S3-compatible bucket for Litestream.
READER_BUCKET_NAME=
READER_BUCKET_ENDPOINT=
READER_BUCKET_REGION=
READER_BUCKET_KEY_ID=
READER_BUCKET_SECRET=

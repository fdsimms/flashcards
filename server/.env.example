# Copy to .env and fill in. .env holds the password: it's in .gitignore, don't commit it.
DOMAIN=anki.example.com
ANKI_USER=me
ANKI_PASSWORD=choose-a-long-password

# The MCP, for using your collection from Claude (README.md, "Use it from Claude"). Remove the
# # from COMPOSE_PROFILES to turn it on.
# COMPOSE_PROFILES=mcp
# Asked for once when you connect a Claude app. At least 12 characters, not the Anki password.
MCP_PASSWORD=
# For recorded audio (optional): an Azure Speech resource's key and region, e.g. westeurope.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

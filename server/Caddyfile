# HTTPS for $DOMAIN, with a certificate from Let's Encrypt: Anki's sync requests go to the sync
# server, /reader/... to Read & Listen with /reader taken off, everything else to the MCP (each
# only when it's turned on; without it those paths answer 502).
#
# Read & Listen and the MCP read a whole request into memory before they check who sent it, so a
# request's size is limited here, above the largest either takes (a topic's photo, about 6 MB, and
# the MCP's own 4 MiB). Sync has Anki's own limit (MAX_SYNC_PAYLOAD_MEGS). CI checks this file
# (.github/workflows/test.yml, `deploy`): a mistake here would take all three down at the next update.
{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	@anki path /sync/* /msync/* /health
	handle @anki {
		# Anki's sync server unpacks a request's body before it checks who sent it, up to three times
		# MAX_SYNC_PAYLOAD_MEGS, so a small zstd file from anyone could make it allocate gigabytes
		# (#709). With ANKI_HKEY set (.env, README.md: Sync key), a request that doesn't carry that
		# key is refused here: in the anki-sync header's JSON ("k"), or media sync's ?k= on its
		# first request. Old clients that send the key inside a multipart body are refused too;
		# every current Anki, AnkiMobile, AnkiDroid and Franki send the header. A login carries no key
		# yet, so its body is capped instead: one is about 100 bytes, and 1 KB unpacks to tens of MB
		# at most. Without ANKI_HKEY, only the login cap applies.
		@unkeyed {
			path /sync/* /msync/*
			not path /sync/hostKey
			expression `"{$ANKI_HKEY}" != ""`
			not header_regexp anki-sync `"k":"{$ANKI_HKEY}"`
			not query k={$ANKI_HKEY}
		}
		respond @unkeyed "Sign in to sync." 403
		@login path /sync/hostKey
		request_body @login {
			max_size 1KB
		}
		# A larger read buffer, as Anki's manual says for Caddy (sync-server.md, "Reverse Proxies"):
		# with Caddy's default, downloading media can fail mid-stream, which AnkiMobile shows as
		# "stream failure (code=303)" (#156).
		reverse_proxy anki:8080 {
			transport http {
				read_buffer 512k
			}
		}
	}
	handle /reader/* {
		request_body {
			max_size 8MB
		}
		uri strip_prefix /reader
		reverse_proxy reader:8080
	}
	handle {
		request_body {
			max_size 5MB
		}
		reverse_proxy mcp:8000
	}
}
